.vscode/

# Runtime pipeline and report outputs — generated, not tracked
pycsamt_report/
pycsamt_workflow_output/
tempfile

# Development plan files
CLI_PLAN.md
docs/DOCUMENTATION_*.md
AI-INVERSION.md


# Pipeline run output — generated by pipeline integration tests and pipeline.run()
pipe_results/

# MARE2DEM example data — copied from mare2dem_examples/ for local testing only
data/mare2dem/

# MARE2DEM downloaded source tree — too large to commit (~49 MB)
# The .gitkeep placeholder in _source/ is committed; actual sources are not.
pycsamt/models/mare2dem/_source/*
!pycsamt/models/mare2dem/_source/.gitkeep
# Auto-generated Make include files written during build
pycsamt/models/mare2dem/_source/_pycsamt_build/

# paper_repro/ — local reproducibility scaffold:
# scripts, generated figures, model checkpoints,
# and experiment outputs are NOT tracked.
# Individual scripts are committed separately
# when stable (see paper_repro/scripts/).
paper_repro/figures/
paper_repro/outputs/
paper_repro/models/*.npz
paper_repro/models/*_metadata.json
*updated.zip # zip files should be excluded 
# RAG index (generated)
.pycsamt_rag/

# generated by gallery example scripts at build time
docs/examples/**/edi_out/
docs/examples/**/workspaces/
docs/examples/topo/l18_prepared_workspace/
