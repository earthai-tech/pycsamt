/* pycsamt desktop — dark theme
   Phase 1: base palette; refined per-widget rules added during implementation.
*/

QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Noto Sans", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #181825;
}

/* ── Menu bar ─────────────────────────────────────────────────────────── */
QMenuBar {
    background-color: #181825;
    color: #cdd6f4;
    border-bottom: 1px solid #313244;
}
QMenuBar::item:selected {
    background-color: #313244;
    border-radius: 4px;
}
QMenu {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
}
QMenu::item:selected {
    background-color: #89b4fa;
    color: #1e1e2e;
}
QMenu::item:disabled {
    color: #6c7086;
}

/* ── Toolbar ──────────────────────────────────────────────────────────── */
QToolBar {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    spacing: 4px;
    padding: 2px 4px;
}
QToolButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 4px 6px;
}
QToolButton:hover {
    background-color: #313244;
}
QToolButton:pressed {
    background-color: #45475a;
}
QToolButton#MoreToolButton {
    border: 1px solid #585b70;
    border-radius: 5px;
    padding: 3px 8px;
    color: #cdd6f4;
    font-weight: 600;
}
QToolButton#MoreToolButton:hover {
    background-color: #313244;
    border-color: #89b4fa;
}
QToolButton#MoreToolButton::menu-indicator { width: 0; }


/* Toolbar overflow button ("…", shown when the tools do not fit):
   outlined so it reads on both themes; its icon is painted in the
   theme's text colour by MainWindow._style_toolbar_overflow. */
QToolButton#qt_toolbar_ext_button {
    background-color: #313244;
    border: 1px solid #585b70;
    border-radius: 5px;
    padding: 0px;
    margin: 2px 1px;
    min-width: 14px;
}
QToolButton#qt_toolbar_ext_button:hover {
    background-color: #45475a;
    border-color: #89b4fa;
}

/* ── Status bar ───────────────────────────────────────────────────────── */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    border-top: 1px solid #313244;
}

/* ── Dock widgets ─────────────────────────────────────────────────────── */
QDockWidget {
    color: #cdd6f4;
}
QDockWidget::title {
    background-color: #181825;
    border-bottom: 1px solid #313244;
    padding: 4px 8px;
    font-weight: 600;
}

/* ── Table view ───────────────────────────────────────────────────────── */
QTableView {
    background-color: #1e1e2e;
    alternate-background-color: #181825;
    gridline-color: #313244;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
    border: none;
}
QTableView::item:selected,
QTableView::item:selected:active,
QTableView::item:selected:!active {
    background-color: #3b82f6;
    color: #ffffff;
}
QTableView::item:hover:!selected {
    background-color: #2563eb;
    color: #ffffff;
}
QHeaderView::section {
    background-color: #181825;
    color: #a6adc8;
    border: none;
    border-right: 1px solid #313244;
    padding: 4px 8px;
    font-weight: 600;
}

/* ── Scroll bars ──────────────────────────────────────────────────────── */
QScrollBar:vertical {
    background-color: #181825;
    width: 10px;
    border: none;
}
QScrollBar::handle:vertical {
    background-color: #45475a;
    border-radius: 5px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #585b70;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: #181825;
    height: 10px;
    border: none;
}
QScrollBar::handle:horizontal {
    background-color: #45475a;
    border-radius: 5px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #585b70;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ── Push buttons ─────────────────────────────────────────────────────── */
QPushButton {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 5px 14px;
}
QPushButton:hover {
    background-color: #45475a;
    border-color: #89b4fa;
}
QPushButton:pressed {
    background-color: #89b4fa;
    color: #1e1e2e;
}
QPushButton:disabled {
    color: #585b70;
    border-color: #313244;
}

/* ── ComboBox ─────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 8px;
}
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

/* ── Line edit / plain text edit ─────────────────────────────────────── */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #181825;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}
QLineEdit:focus, QPlainTextEdit:focus {
    border-color: #89b4fa;
}

/* ── Tab widget ───────────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #313244;
    background-color: #1e1e2e;
}
QTabBar::tab {
    background-color: #181825;
    color: #a6adc8;
    border: none;
    padding: 6px 14px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border-bottom: 2px solid #89b4fa;
}
QTabBar::tab:hover {
    background-color: #313244;
    color: #cdd6f4;
}

/* ── Splitter ─────────────────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #313244;
}
QSplitter::handle:horizontal {
    width: 2px;
}
QSplitter::handle:vertical {
    height: 2px;
}

/* ── Progress bar ─────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #313244;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 4px;
}

/* ── Correction panel stack list ─────────────────────────────────────── */
QListWidget#StackList {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    font-size: 12px;
    color: #a6adc8;
}
QListWidget#StackList::item {
    padding: 3px 4px;
}
QListWidget#StackList::item:selected {
    background-color: #313244;
    color: #89b4fa;
}

/* ── Commit / Revert buttons ──────────────────────────────────────────── */
QPushButton#CommitButton {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    padding: 6px 14px;
}
QPushButton#CommitButton:hover {
    background-color: #b4d0fa;
}
QPushButton#CommitButton:pressed {
    background-color: #74c7ec;
}
QPushButton#CommitButton:disabled {
    background-color: #313244;
    color: #585b70;
}
QPushButton#RevertButton {
    background-color: transparent;
    border: 1px solid #f38ba8;
    border-radius: 6px;
    color: #f38ba8;
    padding: 5px 14px;
}
QPushButton#RevertButton:hover {
    background-color: rgba(243, 139, 168, 0.15);
}
QPushButton#RevertButton:disabled {
    color: #45475a;
    border-color: #313244;
}

/* ── Canvas section labels ────────────────────────────────────────────── */
QLabel#CanvasLabel {
    background-color: #181825;
    color: #6c7086;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    padding-left: 6px;
    border-bottom: 1px solid #313244;
}

/* ── Station detail scroll area ───────────────────────────────────────── */
QScrollArea#DetailScrollArea {
    background-color: transparent;
    border: none;
}
QWidget#DetailBody {
    background-color: transparent;
}

/* Survey analytics dashboard */
QFrame#SurveyKpiCard {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 9px;
}
QLabel#SurveyKpiLabel {
    color: #7f849c;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.7px;
}
QLabel#SurveyKpiValue {
    color: #89b4fa;
    font-size: 25px;
    font-weight: 700;
}
QLabel#SurveyKpiSubtext, QLabel#SurveyMeta {
    color: #a6adc8;
    font-size: 11px;
}
QLabel#SurveyMeta {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 7px 10px;
}
QScrollArea#SurveyDashboardScroll, QWidget#SurveyDashboardBody {
    background-color: transparent;
    border: none;
}

/* ── Drop zone (LoadDataDialog) ───────────────────────────────────────── */
QLabel#DropZone {
    border: 2px dashed #585b70;
    border-radius: 10px;
    background-color: #181825;
    color: #6c7086;
    font-size: 13px;
    padding: 12px;
}
QLabel#DropZone:hover {
    border-color: #89b4fa;
    color: #a6adc8;
}
QLabel#DropZone[drag_over="true"] {
    border-color: #89b4fa;
    background-color: rgba(137, 180, 250, 0.10);
    color: #89b4fa;
    font-weight: 600;
}

/* ── File-list management buttons ─────────────────────────────────────── */
QPushButton#FileListBtn {
    background-color: transparent;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 12px;
    color: #a6adc8;
}
QPushButton#FileListBtn:hover {
    border-color: #89b4fa;
    color: #89b4fa;
}
QPushButton#FileListBtn:pressed {
    background-color: #313244;
    color: #cdd6f4;
}
QPushButton#FileListBtn:disabled {
    color: #45475a;
    border-color: #313244;
}

/* File count label */
QLabel#FileCountLabel {
    color: #a6adc8;
    font-size: 12px;
    font-weight: 600;
}

/* File list */
QListWidget#FileList {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 6px;
    font-size: 12px;
    color: #cdd6f4;
}
QListWidget#FileList::item {
    padding: 3px 6px;
    border-radius: 3px;
}
QListWidget#FileList::item:selected {
    background-color: #313244;
    color: #89b4fa;
}
QListWidget#FileList::item:hover {
    background-color: #1e1e2e;
}

/* ── Survey Overview widget ────────────────────────────────────────────── */
QWidget#SurveyOverview {
    background-color: #1e1e2e;
}
QLabel#SurveyIcon {
    color: #89b4fa;
    font-size: 16px;
    font-weight: 700;
}
QLabel#SurveyOverviewTitle {
    color: #cdd6f4;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
}
QLabel#SurveyStatKey {
    color: #6c7086;
    font-size: 12px;
}
QLabel#SurveyStatValue {
    color: #cdd6f4;
    font-size: 12px;
    font-weight: 600;
}
QLabel#SurveyPlaceholder {
    color: #45475a;
    font-size: 12px;
    padding: 16px;
}

/* ── Correction panel — redesigned left params (v2) ─────────────────── */

/* Small muted field labels above each combo */
QLabel#FieldLabel {
    color: #6c7086;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.4px;
    padding: 4px 0 0 0;
}

/* Category combo — slightly taller, accent border on focus */
QComboBox#CategoryCombo {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 600;
    color: #cdd6f4;
}
QComboBox#CategoryCombo:focus,
QComboBox#CategoryCombo:on {
    border-color: #89b4fa;
}

/* Correction sub-combo */
QComboBox#CorrectionCombo {
    background-color: #1e1e2e;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 4px 10px;
    color: #cdd6f4;
}
QComboBox#CorrectionCombo:focus,
QComboBox#CorrectionCombo:on {
    border-color: #74c7ec;
}

/* Description chip — left accent bar */
QLabel#DescChip {
    color: #a6adc8;
    font-size: 11px;
    font-style: italic;
    padding: 4px 6px 4px 10px;
    border-left: 3px solid #45475a;
    background-color: #181825;
    border-radius: 0 4px 4px 0;
}

/* Generic info/status labels */
QLabel#InfoLabel {
    color: #6c7086;
    font-size: 11px;
}

/* ── Agent Browser — detail panel ────────────────────────────────────── */

/* Selected-agent name shown at top of detail panel */
QLabel#DetailHeader {
    color: #89b4fa;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 0;
    letter-spacing: 0.3px;
}

/* Horizontal rule between header and params */
QFrame#Separator {
    color: #313244;
    background-color: #313244;
    max-height: 1px;
    border: none;
}

/* Category chip tab bar — overrides global QTabBar rules for this ID */
QTabBar#CategoryTabBar::tab {
    background-color: #313244;
    color: #a6adc8;
    border: none;
    padding: 3px 10px;
    margin-right: 2px;
    border-radius: 10px;
    font-size: 11px;
}
QTabBar#CategoryTabBar::tab:selected {
    background-color: #89b4fa;
    color: #1e1e2e;
    font-weight: 700;
}
QTabBar#CategoryTabBar::tab:hover:!selected {
    background-color: #45475a;
    color: #cdd6f4;
}

/* Agent card list container */
QListWidget#AgentCardList {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget#AgentCardList::item {
    border-radius: 5px;
    padding: 0px;
}
QListWidget#AgentCardList::item:selected {
    background-color: rgba(137, 180, 250, 0.14);
    border: 1px solid rgba(137, 180, 250, 0.35);
}
QListWidget#AgentCardList::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.04);
}

/* Search bar in browser */
QLineEdit#AgentSearch {
    background-color: #181825;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}
QLineEdit#AgentSearch:focus {
    border-color: #89b4fa;
}

/* ── Recompute Dialog ─────────────────────────────────────────────────── */
QProgressBar#RecomputeProgressBar {
    background-color: #313244;
    border: none;
    border-radius: 5px;
    min-height: 10px;
    max-height: 10px;
}
QProgressBar#RecomputeProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #89dceb, stop:1 #a6e3a1);
    border-radius: 5px;
}
QLabel#RecomputeCurrentLabel {
    color: #a6adc8;
    font-size: 12px;
    font-style: italic;
}
QLabel#RecomputeOkLabel {
    color: #a6e3a1;
    font-weight: 600;
    font-size: 12px;
}
QLabel#RecomputeFailedLabel {
    color: #f38ba8;
    font-weight: 600;
    font-size: 12px;
}
QLabel#RecomputePendingLabel {
    color: #6c7086;
    font-size: 12px;
}
QListWidget#RecomputeLogList {
    background-color: #11111b;
    border: 1px solid #313244;
    border-radius: 6px;
    font-family: "Courier New", monospace;
    font-size: 11px;
    color: #cdd6f4;
}
QListWidget#RecomputeLogList::item {
    padding: 1px 4px;
}
QPushButton#RecomputeRunBtn {
    background-color: #89b4fa;
    color: #1e1e2e;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    padding: 6px 18px;
    min-width: 130px;
}
QPushButton#RecomputeRunBtn:hover {
    background-color: #b4d0fa;
}
QPushButton#RecomputeRunBtn:pressed {
    background-color: #74c7ec;
}
QPushButton#RecomputeLoadBtn {
    background-color: #a6e3a1;
    color: #1e1e2e;
    border: none;
    border-radius: 6px;
    font-weight: 700;
    padding: 6px 14px;
}
QPushButton#RecomputeLoadBtn:hover {
    background-color: #c6e8c1;
}

/* ── SearchableComboBox popup ────────────────────────────────────────────── */
QComboBox#StationCombo {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 26px;
}
QComboBox#StationCombo:focus {
    border-color: #89b4fa;
}
QComboBox#StationCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #45475a;
}

QFrame#StationPopupFrame {
    background-color: #1e1e2e;
    border: 1px solid #45475a;
    border-radius: 6px;
}

QLineEdit#StationSearch {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}
QLineEdit#StationSearch:focus {
    border-color: #89b4fa;
}

QFrame#StationPopupSep {
    color: #45475a;
    max-height: 1px;
}

QListWidget#StationList {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: none;
    outline: none;
}
QListWidget#StationList::item {
    padding: 4px 8px;
    border-radius: 3px;
}
QListWidget#StationList::item:hover {
    background-color: #313244;
}
QListWidget#StationList::item:selected {
    background-color: #45475a;
    color: #89dceb;
}

/* Analytical result unavailable / not-computable state */
QWidget#UnavailableResultView { background: #1e1e2e; }
QFrame#UnavailableResultCard {
    background: #181825;
    border: 1px solid #45475a;
    border-radius: 12px;
}
QLabel#UnavailableResultBadge {
    background: #313244;
    color: #89b4fa;
    border: 1px solid #45475a;
    border-radius: 13px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 2px 12px;
}
QLabel#UnavailableResultTitle {
    color: #cdd6f4;
    font-size: 20px;
    font-weight: 650;
    border: none;
}
QLabel#UnavailableResultReason {
    color: #bac2de;
    font-size: 13px;
    border: none;
}
QLabel#UnavailableResultGuidance {
    background: #1e1e2e;
    color: #a6adc8;
    border: 1px solid #313244;
    border-radius: 7px;
    padding: 10px 14px;
    font-size: 12px;
}

QToolButton#PlotRefreshOverlay {
    background: rgba(30, 30, 46, 32);
    color: rgba(205, 214, 244, 90);
    border: 1px solid rgba(69, 71, 90, 45);
    border-radius: 18px;
    font-size: 19px;
    font-weight: 700;
}
QToolButton#PlotRefreshOverlay:hover {
    background: rgba(49, 50, 68, 235);
    color: #cdd6f4;
    border-color: #89b4fa;
}
QToolButton#PlotRefreshOverlay:pressed {
    background: #45475a;
    color: #89dceb;
}

/* Keep the compact KPI cards visually continuous. */
QLabel#SurveyKpiLabel, QLabel#SurveyKpiValue, QLabel#SurveyKpiSubtext {
    background: transparent;
    border: none;
}

/* Explicit radio indicators: independent of the native Windows theme. */
QRadioButton { spacing: 7px; background: transparent; }
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px;
    border: 1px solid #7f849c;
    background: #181825;
}
QRadioButton::indicator:checked {
    border-color: #89b4fa;
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        fx:0.5, fy:0.5, stop:0 #89b4fa, stop:0.48 #89b4fa,
        stop:0.52 #181825, stop:1 #181825);
}
QRadioButton::indicator:hover { border: 1px solid #89b4fa; }
QRadioButton::indicator:focus { border: 2px solid #89b4fa; }
QRadioButton::indicator:disabled { border-color: #585b70; }
QRadioButton::indicator:checked:disabled {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5,
        fx:0.5, fy:0.5, stop:0 #585b70, stop:0.48 #585b70,
        stop:0.52 #181825, stop:1 #181825);
}
