# Pipeline run output — generated by pipeline integration tests and pipeline.run()
pipe_results/

# MARE2DEM example data — copied from mare2dem_examples/ for local testing only
data/mare2dem/

# MARE2DEM downloaded source tree — too large to commit (~49 MB)
# The .gitkeep placeholder in _source/ is committed; actual sources are not.
pycsamt/models/mare2dem/_source/*
!pycsamt/models/mare2dem/_source/.gitkeep
# Auto-generated Make include files written during build
pycsamt/models/mare2dem/_source/_pycsamt_build/

# ModEM build artifacts — the Fortran *source* under
# pycsamt/models/modem/_source/ is deliberately vendored/committed,
# but compiled outputs (binary, object files, .mod files, and any
# runtime DLLs copied alongside the binary for a self-contained build)
# are build products a user generates locally, not source.
pycsamt/models/modem/_source/*/objs/
pycsamt/models/modem/_source/*/Mod2DMT
pycsamt/models/modem/_source/*/Mod2DMT.exe
pycsamt/models/modem/_source/*/Mod3DMT
pycsamt/models/modem/_source/*/Mod3DMT.exe
pycsamt/models/modem/_source/*/*.dll

# Occam2D build artifacts -- same rationale as the ModEM block above;
# its Makefile builds directly in-place with no separate objs/ dir.
pycsamt/models/occam2d/_source/*.o
pycsamt/models/occam2d/_source/*.mod
pycsamt/models/occam2d/_source/Occam2D
pycsamt/models/occam2d/_source/Occam2D.exe
pycsamt/models/occam2d/_source/*.dll

# paper_repro/ — local reproducibility scaffold:
# scripts, generated figures, model checkpoints,
# and experiment outputs are NOT tracked.
# Individual scripts are committed separately
# when stable (see paper_repro/scripts/).
paper_repro/figures/
paper_repro/outputs/
paper_repro/models/*.npz
paper_repro/models/*_metadata.json
*updated.zip # zip files should be excluded 
