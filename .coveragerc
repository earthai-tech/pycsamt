[run]
branch = True
# exclude files
omit =
    # exclude everything from ui_asset as they ara either resources or code dynamically generated
    */ui_asset/*
    # test code itself must not count toward (or against) coverage
    */tests/*
    */conftest.py
    # third-party-derived collections (BSD-3, imported from watex)
    */pycsamt/utils/funcutils.py
    */pycsamt/utils/exmath.py
    # v1-legacy module slated for deprecation
    */pycsamt/utils/em.py
    # externally sourced compatibility shims — not ours to test
    */pycsamt/compat/*
    # v1 plotting subpackage removed from the tree; keep old reports honest
    */pycsamt/plot/*
    # type aliases only, nothing executable to test
    */pycsamt/_typing.py
    # static configuration containers
    */pycsamt/config.py
    # geospatial standard configuration (EPSG/projection constants)
    */pycsamt/projection.py
    # legacy site/borehole location helper, slated for removal
    */pycsamt/loc.py


[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code:
    def __repr__
    if self\.debug

    # Don't complain if tests don't hit defensive assertion code:
    raise NotImplemented.*
    raise .*Exception.*
    raise .*Error.*

    # Don't complain if non-runnable code isn't run:
    if 0:
    if __name__ == .__main__.:

ignore_errors = True

[html]
directory = coverage_html_report
