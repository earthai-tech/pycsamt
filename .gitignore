# All field / survey data — may contain confidential site information
data/*

# Exception: small AMT/MT lines used as bundled sample data for the
# pycsamt.emtools sphinx-gallery examples (docs/source/emtools/examples/).
# Only L18PLT and L22PLT of WILLY_DATA are tracked — L26PLT/L30PLT/L34PLT
# stay ignored (usable locally, never committed) to keep the repo small.
# (Re-excluding each level with "dir/*" — not a bare "dir/" — is required so
# git still descends far enough to see the nested "!" re-includes below.)
!data/AMT
data/AMT/*
!data/AMT/WILLY_DATA
data/AMT/WILLY_DATA/*
!data/AMT/WILLY_DATA/L18PLT
!data/AMT/WILLY_DATA/L22PLT
!data/AMT/WILLY_DATA/README.md

!data/MT
data/MT/*
!data/MT/kap03lmt_edis
!data/MT/README.md

# Exception: de-identified copies of two real cross-power-spectra EDI
# files, used as bundled sample data for the emtools.spectra gallery.
# The originals (HBH03.edi, ZBR02.edi) are real private field data and
# must never be tracked — only these sanitized, renamed copies are.
!data/MT/SPECTRA
data/MT/SPECTRA/*
!data/MT/SPECTRA/spectra01.edi
!data/MT/SPECTRA/spectra02.edi
!data/MT/SPECTRA/README.md

# Exception: bundled CSAMT survey (Tongkeng area, Hunan Province, China)
# used by pycsamt.seg true-file tests (edi_csamt_file / any_edi_file
# fixtures in conftest.py) and CSAMT theory/user-guide examples. Published
# in Kouadio et al. (2020, J. Applied Geophysics) — see data/CSAMT/README.md
# and docs/source/references.rst — so the full 10-station line is tracked.
!data/CSAMT
data/CSAMT/*
!data/CSAMT/csa*.edi
!data/CSAMT/README.md

# Exception: bundled Jones (.j) sample data used by pycsamt.jones tests
# (j_single_file / jc_path fixtures in conftest.py) — one standalone file
# plus a small 4-station collection.
!data/j
data/j/*
!data/j/kb0-s001.txt
!data/j/nia
!data/j/nia/*

# Exception: compact ModEM result subset used by inversion-gallery examples.
# The complete production result directory is large and remains local-only;
# this folder keeps only controls, logs, input data, and three representative
# iteration snapshots for result-loading and convergence examples.
!data/modem
data/modem/*
!data/modem/willy_27freq_watex_line02_sample
!data/modem/willy_27freq_watex_line02_sample/**
!data/modem/rerun-amt-bhs
!data/modem/rerun-amt-bhs/**

# Exception: compact TEMAVG sample set used by TDEM reader, workflow, CLI,
# and plotting tests. The complete JIANGSU line remains local-only; keep one
# full TEM100 companion set plus TEM1020.AVG for quality-marker coverage.
!data/TEMAVG
data/TEMAVG/*
!data/TEMAVG/JIANGSU
data/TEMAVG/JIANGSU/*
!data/TEMAVG/JIANGSU/TEM100.AVG
!data/TEMAVG/JIANGSU/TEM100.LOG
!data/TEMAVG/JIANGSU/TEM100.Z
!data/TEMAVG/JIANGSU/TEM100.mde
!data/TEMAVG/JIANGSU/TEM1020.AVG

# Exception: real Stratagem (Geometrics/EMI K2) AMT field survey — bundled
# sample data for pycsamt.stratagem docs/tests. WinGLink-exported EDIs, the
# GPS reference table, and the field report are kept in full; only the
# usable (ASCII 19-column) raw hardware files are kept — X2HX.*/Z2HX.* plus
# calibration/sensor files. Y2HX.* raw files stay local-only: they are
# binary time-series captures, not the 19-column ASCII format
# StratagemRawReader parses, and account for ~127 MB of the 133 MB k2-HX
# directory.
!data/stratagem
data/stratagem/*
!data/stratagem/K2
data/stratagem/K2/*
!data/stratagem/K2/README.md
!data/stratagem/K2/k2-gps-ref.csv
!data/stratagem/K2/k2-gps-aligned.csv
!data/stratagem/K2/build_gps_aligned.py
!data/stratagem/K2/k2-gps.xls
!data/stratagem/K2/k2-field-report.docx
!data/stratagem/K2/k2-edi
!data/stratagem/K2/k2-edi/**
!data/stratagem/K2/k2-corrected-sample
!data/stratagem/K2/k2-corrected-sample/**
!data/stratagem/K2/k2-renamed-sample
!data/stratagem/K2/k2-renamed-sample/**
!data/stratagem/K2/k2-HX
data/stratagem/K2/k2-HX/*
!data/stratagem/K2/k2-HX/X2HX.*
!data/stratagem/K2/k2-HX/Z2HX.*
!data/stratagem/K2/k2-HX/SENSORS.TBL
!data/stratagem/K2/k2-HX/@
!data/stratagem/K2/k2-HX/@S
!data/stratagem/K2/k2-HX/AFEV3.*
!data/stratagem/K2/k2-HX/BE26V2.*
!data/stratagem/K2/k2-HX/S746_HX.*
!data/stratagem/K2/k2-HX/S747_HY.*

# Inversion-plot runs (rendered PNGs, ~18 MB) are local-only outputs and
# must never be committed — GitHub repo-size hygiene. ``data/*`` already
# ignores them; the previous "!" exception that tracked 27-frequ-watex-
# data-02 was removed and the folder untracked (kept locally for testing).
# Likewise data/iter2dat (Occam iteration exports) is a local-only output.

# Demo scripts and generated figures — committed separately when stable
examples/

# Exception: sphinx-gallery example *source* scripts under
# docs/examples/<section>/ — hand-written, not generated, and must be
# tracked so the gallery can be rebuilt from a checkout. The generated
# gallery (docs/source/examples/) stays ignored via the rule above.
!docs/examples/
!docs/examples/**
# ...but the "!" above re-includes everything, so re-exclude the compiled
# caches it would otherwise track (the global __pycache__ rule is overridden
# inside a force-included tree).
docs/examples/**/__pycache__/
docs/examples/**/*.py[cod]

