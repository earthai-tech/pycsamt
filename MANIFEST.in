# MANIFEST.in — pyCSAMT v2
# Controls which files are bundled in the source distribution (sdist).
# Binary packages (wheels) use pyproject.toml [tool.setuptools.package-data].

# Project root files
include README.md
include LICENSE.md
include pyproject.toml
include MANIFEST.in

# Documentation is intentionally NOT shipped in the sdist. `graft docs/source`
# used to pull the whole tree in -- multi-MB walkthrough GIFs, hundreds of
# screenshots, and the generated sphinx-gallery output (docs/source/examples/**,
# .rst files with base64-embedded images at ~10 MB each). That inflated the
# sdist past PyPI's 100 MB per-file limit, so only the wheel could upload. Docs
# live in the repo and on the docs site; the sdist only needs to build/install
# the package.

# Package data (mirrors [tool.setuptools.package-data] in pyproject.toml)
include pycsamt/log/p.configlog.yml
recursive-include pycsamt/metadata *.json *.yml
recursive-include pycsamt/models/occam2d/_source *
recursive-include pycsamt/models/modem/_source *
recursive-include pycsamt/data/occam2d *
include pycsamt/data/3edis/*.edi
recursive-include pycsamt/app/web/assets *
recursive-include pycsamt/app/mapview/assets *
recursive-include pycsamt/data/inversionFiles *

# Exclude build artefacts and caches
global-exclude *.py[cod]
global-exclude __pycache__/*
global-exclude *.so *.dylib
global-exclude .coverage .coverage.*
global-exclude .DS_Store

# Exclude docs, local scratch/output dirs, and dev workspaces
prune docs
prune paper
prune .tmp
prune pycsamt_report
prune pycsamt_workflow_output

# Exclude legacy v1 artefacts
prune pycsamt/*_v1*
prune pycsamt/geodrill*
prune pycsamt/view*
prune pycsamt/gui_v1*
prune pycsamt/cli_v1*
prune pycsamt/modeling_v1*
prune pycsamt/plot_v1*
prune pycsamt/processing_v1*
prune pycsamt/_core_v1*
prune pycsamt/utils_v1*
exclude setup.py
